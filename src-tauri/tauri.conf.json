{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cove",
  "version": "1.2.0",
  "identifier": "com.saymiao.netease-music-player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cove · 可沃",
        "label": "main",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "maxWidth": 1600,
        "maxHeight": 1000,
        "decorations": false,
        "center": true,
        "resizable": true,
        "transparent": true,
        "shadow": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data:; img-src 'self' data: http: https:; media-src 'self' data: blob: http: https:; connect-src 'self' http://localhost:5000 http://127.0.0.1:5000 http: https: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
