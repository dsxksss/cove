{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cove",
  "version": "1.5.3",
  "identifier": "com.saymiao.netease-music-player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cove · 可沃",
        "label": "main",
        "width": 1080,
        "height": 700,
        "minWidth": 700,
        "minHeight": 700,
        "maxWidth": 1080,
        "maxHeight": 700,
        "decorations": false,
        "center": true,
        "resizable": true,
        "transparent": true,
        "shadow": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data: http: https:; media-src 'self' data: blob: http: https:; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "resources": ["resources/ncm2acc"],
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
